appname                    = upslink
version                    = 1.2.0
display_name               = UPS 联动
desc                       = 把飞牛接入局域网内已有的 NUT 网络 UPS 服务（群晖、绿联或任何兼容 NUT 的上游）。只有明确收到 OB 电池供电、LB 低电量、FSD 强制关机才会关机；网络中断与上游离线只记日志不关机，自动关机默认关闭。
maintainer                 = UPSLink
distributor                = UPSLink
source                     = thirdparty
platform                   = x86
os_min_version             = 0.9.0
desktop_uidir              = ui
desktop_applaunchname      = upslink.main
service_port               = 8099
ctl_stop                   = true
checkport                  = true
disable_authorization_path = true
changelog                  = 1.2.0：电池更换提醒。新增投运日期登记（默认周期 24 个月、可改），到期前 60 天转黄、30 天转红，并在卡片与顶部提示条同时告警；从历史断电区间反推实测容量并记录基线（负载变化自动归一化），衰减 15% 提醒、30% 直接判定需更换；连续 7 天充不到 100% 视为内阻上升预警；读取 ups.test.date 提示 UPS 自检记录。关机策略与决策逻辑完全不变，电池健康只做提示，不参与任何关机判断。
